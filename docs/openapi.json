{
  "openapi": "3.1.0",
  "info": {
    "title": "Footnote",
    "description": "Answers questions about fifteen companies' SEC annual reports, with citations, recomputed figures and explicit refusals when the evidence is insufficient.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "description": "Liveness and data readiness: the database answers and the corpus is loaded.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "questions"
        ],
        "summary": "Ask Endpoint",
        "description": "Answer a question. Pass `previous_answer_id` to ask for the evidence behind an earlier answer.",
        "operationId": "ask_endpoint_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "retrieval"
        ],
        "summary": "Search Endpoint",
        "description": "Hybrid search over the annual-report passages, with optional company, year and section filters.",
        "operationId": "search_endpoint_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 300,
              "title": "Q"
            }
          },
          {
            "name": "ticker",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ticker"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          {
            "name": "item",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Item"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 1,
              "default": 8,
              "title": "K"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Search Endpoint Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/companies": {
      "get": {
        "tags": [
          "corpus"
        ],
        "summary": "Companies",
        "operationId": "companies_companies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Companies Companies Get"
                }
              }
            }
          }
        }
      }
    },
    "/scope": {
      "get": {
        "tags": [
          "corpus"
        ],
        "summary": "Scope",
        "description": "What the system will and will not answer about.",
        "operationId": "scope_scope_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Scope Scope Get"
                }
              }
            }
          }
        }
      }
    },
    "/history": {
      "get": {
        "tags": [
          "questions"
        ],
        "summary": "History",
        "operationId": "history_history_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response History History Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "answer_id": {
            "type": "string",
            "title": "Answer Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "title": "Segments"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "calculations": {
            "items": {
              "$ref": "#/components/schemas/Calculation"
            },
            "type": "array",
            "title": "Calculations"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array",
            "title": "Checks"
          },
          "table": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Table"
          },
          "clarification_options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Clarification Options"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "narrator": {
            "type": "string",
            "title": "Narrator",
            "default": "template"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sql"
          }
        },
        "type": "object",
        "required": [
          "answer_id",
          "question",
          "status",
          "route",
          "answer"
        ],
        "title": "Answer"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "previous_answer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Answer Id"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "Calculation": {
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "formula": {
            "type": "string",
            "title": "Formula"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/CalculationInput"
            },
            "type": "array",
            "title": "Inputs"
          },
          "result": {
            "type": "number",
            "title": "Result"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          }
        },
        "type": "object",
        "required": [
          "description",
          "formula",
          "inputs",
          "result",
          "unit"
        ],
        "title": "Calculation"
      },
      "CalculationInput": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "citation_id": {
            "type": "integer",
            "title": "Citation Id"
          }
        },
        "type": "object",
        "required": [
          "label",
          "value",
          "citation_id"
        ],
        "title": "CalculationInput"
      },
      "Check": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "passed"
        ],
        "title": "Check"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "fiscal_year": {
            "type": "integer",
            "title": "Fiscal Year"
          },
          "form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Form"
          },
          "filed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filed"
          },
          "accession": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accession"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "xbrl_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xbrl Tag"
          },
          "snippet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "company",
          "ticker",
          "fiscal_year",
          "location"
        ],
        "title": "Citation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Route": {
        "type": "string",
        "enum": [
          "sql",
          "sql_calculation",
          "sql_and_document",
          "comparison",
          "document",
          "evidence",
          "clarify",
          "refuse"
        ],
        "title": "Route"
      },
      "SearchHit": {
        "properties": {
          "chunk_id": {
            "type": "integer",
            "title": "Chunk Id"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "fiscal_year": {
            "type": "integer",
            "title": "Fiscal Year"
          },
          "item": {
            "type": "string",
            "title": "Item"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "vector_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Rank"
          },
          "bm25_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bm25 Rank"
          },
          "similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "accession": {
            "type": "string",
            "title": "Accession"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "filed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filed"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "ticker",
          "company",
          "fiscal_year",
          "item",
          "section",
          "page",
          "score",
          "vector_rank",
          "bm25_rank",
          "text",
          "accession",
          "url"
        ],
        "title": "SearchHit"
      },
      "Segment": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citation_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Citation Ids"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "computed"
          },
          "bullet": {
            "type": "boolean",
            "title": "Bullet",
            "default": false
          },
          "calc_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calc Index"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Segment",
        "description": "One sentence or bullet of the answer and the evidence behind it."
      },
      "Status": {
        "type": "string",
        "enum": [
          "verified",
          "partially_verified",
          "ambiguous",
          "insufficient_evidence",
          "refused"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}